OTPRAVKARR_SECRET=             # master encryption secret (required) | Generate a secret: `openssl rand -base64 32`
DATABASE_PATH=./data/otpravkarr.sqlite
HOST=0.0.0.0
PORT=3000
ORIGIN=http://localhost:3000   # the address people open in the browser; required for plain HTTP. Leave unset only behind an HTTPS reverse proxy that passes the original Host. Always allowed by the app's origin check; allowed origins saved in setup or Settings add to it
# ADDRESS_HEADER=x-forwarded-for   # behind a reverse proxy, only when every request goes through it (rate limiting then keys on the client address)
# XFF_DEPTH=1                      # with ADDRESS_HEADER: the number of proxies (default 1)
# PROTOCOL_HEADER=x-forwarded-proto  # only without ORIGIN, behind a trusted proxy; HOST_HEADER likewise
# SHUTDOWN_TIMEOUT=30              # seconds to drain requests on SIGTERM/SIGINT (default 30)
# BODY_SIZE_LIMIT=512K             # maximum request body, K/M/G or Infinity (default 512K)
