{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/build",
      "!**/.svelte-kit",
      "!!**/dist",
      "!!**/.omc",
      "!!**/.omx",
      "!!**/dogfood-output",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/e2e/.auth",
      "!**/node_modules",
      "!**/bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/lib/components/SetupWizard.svelte",
        "src/lib/components/ui/sidebar/sidebar-menu-button.svelte",
        "src/routes/(admin)/audit/+page.svelte",
        "src/routes/(admin)/dashboard/+page.svelte",
        "src/routes/(admin)/settings/+page.svelte",
        "src/routes/(admin)/users/+page.svelte",
        "src/routes/(portal)/+page.svelte",
        "src/routes/setup/+page.svelte"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
