{
  "name": "otpravkarr",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && rm -rf build/server/migrations && cp -r src/lib/db/migrations build/server/migrations",
    "preview": "bun --bun vite preview",
    "start": "NODE_ENV=production bun scripts/serve.ts",
    "smoke": "bun run scripts/smoke.ts",
    "prepare": "svelte-kit sync",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "bash scripts/check-e2e.sh",
    "check:types": "svelte-kit sync && tsc --noEmit && svelte-check --threshold warning"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-bun": "1.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/qrcode": "^1.5.6",
    "@unocss/extractor-svelte": "^66.10.5",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/vite": "^66.6.8",
    "bun-types": "^1.4.3",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.0",
    "unocss": "^66.6.8",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^1.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ctrl/plex": "^7.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.55.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "ofetch": "^1.5.1",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.4.2"
}
